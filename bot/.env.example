# Copy to bot/.env and fill in. Never committed -- .gitignore excludes **/.env
# at any depth. In production these are set as real environment variables
# instead, which take precedence over this file.

# Mistral. The library and agent are created once in the Mistral console; the
# script bot/scripts/configure_agent.py fills them with the generated knowledge.
MISTRAL_API_KEY=
MISTRAL_LIBRARY_ID=
AGENT_ID=

# Storage for accounts and feedback. Leave unset locally to use a SQLite file
# at bot/local.db. Must be a postgres:// URL in production: hosting containers
# have ephemeral filesystems and the SQLite file would vanish on every deploy.
DATABASE_URL=
